// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameEn      String
  tagline     String
  taglineEn   String
  description String
  descriptionEn String
  image       String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  nameEn         String
  description    String
  descriptionEn  String
  priceCents     Int
  categorySlug   String
  image          String
  gallery        String
  material       String
  origin         String
  craftingTime   String
  badge          String   @default("none") // "new" | "bestseller" | "none"
  featured       Boolean  @default(false)
  inStock        Boolean  @default(true)
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Category @relation(fields: [categorySlug], references: [slug])
  variants ProductVariant[]

  @@index([categorySlug])
  @@index([featured])
  @@index([badge])
}

/// Variantes d'un produit (couleur, taille, capacité, etc.)
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  label      String   // "Rouge", "Grand", "Modèle A"
  labelEn    String   @default("")
  value      String   // "rouge", "grand", "modele-a"
  color      String?  // code hex (ex: #FF0000) — null si pas une couleur
  priceCents Int      // prix spécifique à la variante (centimes XOF)
  stock      Int      @default(0)
  sku        String?  @unique
  image      String?  // image spécifique (si null → image du produit)
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Comptes utilisateurs (clients + administrateurs).
/// Auth via NextAuth.js (JWT + cookies HttpOnly).
/// 3 rôles : ADMIN (accès complet), MANAGER (catalogue + commandes), CUSTOMER (client).
model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  phone            String?
  password         String    // hashé (scrypt) côté API
  role             String    @default("CUSTOMER") // "ADMIN" | "MANAGER" | "CUSTOMER"
  blocked          Boolean   @default(false) // compte bloqué par l'admin
  resetToken       String?   // token de réinitialisation mot de passe
  resetTokenExpiry DateTime? // expiration du token
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders Order[]
}

/// Commandes — créées lors du checkout (paiement simulé ou réel).
model Order {
  id            String   @id @default(cuid())
  userId        String?
  email         String
  fullName      String
  phone         String?
  address       String
  city          String
  zip           String
  country       String
  shippingCents Int
  totalCents    Int
  status        String   @default("PENDING") // PENDING | PAID | SHIPPED | DELIVERED | CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([email])
  @@index([status])
}

/// Lignes de commande (snapshot du produit au moment de l'achat).
model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  slug       String
  name       String
  priceCents Int
  qty        Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Paiements — un par commande (provider simulé ou PayGate/FedaPay/Stripe).
model Payment {
  id             String @id @default(cuid())
  orderId        String @unique
  provider       String // "SIMULATED" | "PAYGATE" | "FEDAPAY" | "STRIPE"
  transactionId  String
  status         String @default("PENDING") // PENDING | SUCCESS | FAILED
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Codes promo (marketing).
model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  discountPct Int     // pourcentage de réduction, ex: 10 pour 10%
  expiresAt  DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

/// Slides du carrousel hero (page d'accueil).
/// Gérables depuis l'admin sans toucher au code.
model HeroSlide {
  id        String  @id @default(cuid())
  image     String
  eyebrowFr String  @default("")
  eyebrowEn String  @default("")
  titleFr   String
  titleEn   String
  textFr    String  @default("")
  textEn    String  @default("")
  order     Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Images éditables de la page d'accueil (story, material, contact).
/// L'admin peut les remplacer sans toucher au code.
model SiteImage {
  key       String  @id  // "story-1", "story-2", "story-3", "material", "contact-bg"
  url       String
  updatedAt DateTime @updatedAt
}

/// Slides du bandeau promotionnel (page d'accueil).
/// Gérables depuis l'admin sans toucher au code.
model PromoSlide {
  id        String  @id @default(cuid())
  image     String
  titleFr   String  @default("")
  titleEn   String  @default("")
  textFr    String  @default("")
  textEn    String  @default("")
  linkView  String  @default("shop") // shop, story, material, contact
  linkLabelFr String @default("")
  linkLabelEn String @default("")
  bgColor   String  @default("bg-accent") // classe Tailwind ou couleur hex
  order     Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Textes éditables de la page d'accueil (promo, story, material, contact).
/// L'admin peut les modifier en FR et EN sans toucher au code.
model SiteContent {
  key      String  @id
  valueFr  String  @default("")
  valueEn  String  @default("")
}

/// Messages reçus depuis le formulaire de contact.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  reply     String?  @default("")
  createdAt DateTime @default(now())
}

/// Abonnés à la newsletter (footer).
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Paramètres du site (clé-valeur), persistés en DB.
/// Utilisé pour le toggle paiement en ligne, etc.
model SiteSetting {
  key       String  @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Notifications créées par l'admin (annonces, promos, infos).
model Notification {
  id        String   @id @default(cuid())
  title     String
  titleEn   String   @default("")
  message   String
  messageEn String   @default("")
  type      String   @default("info") // info, promo, update
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
