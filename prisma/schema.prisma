// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameEn      String
  tagline     String
  taglineEn   String
  description String
  descriptionEn String
  image       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  nameEn         String
  description    String
  descriptionEn  String
  priceCents     Int
  categorySlug   String
  image          String
  gallery        String
  material       String
  origin         String
  craftingTime   String
  badge          String   @default("none") // "new" | "bestseller" | "none"
  featured       Boolean  @default(false)
  inStock        Boolean  @default(true)
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Category @relation(fields: [categorySlug], references: [slug])

  @@index([categorySlug])
  @@index([featured])
  @@index([badge])
}

/// Comptes utilisateurs (clients + administrateurs).
/// Auth via NextAuth.js (JWT + cookies HttpOnly).
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String   // hashé (bcrypt) côté API
  role      String   @default("CUSTOMER") // "ADMIN" | "CUSTOMER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

/// Commandes — créées lors du checkout (paiement simulé ou réel).
model Order {
  id            String   @id @default(cuid())
  userId        String?
  email         String
  fullName      String
  phone         String?
  address       String
  city          String
  zip           String
  country       String
  shippingCents Int
  totalCents    Int
  status        String   @default("PENDING") // PENDING | PAID | SHIPPED | DELIVERED | CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([email])
  @@index([status])
}

/// Lignes de commande (snapshot du produit au moment de l'achat).
model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  slug       String
  name       String
  priceCents Int
  qty        Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Paiements — un par commande (provider simulé ou PayGate/FedaPay/Stripe).
model Payment {
  id             String @id @default(cuid())
  orderId        String @unique
  provider       String // "SIMULATED" | "PAYGATE" | "FEDAPAY" | "STRIPE"
  transactionId  String
  status         String @default("PENDING") // PENDING | SUCCESS | FAILED
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Codes promo (marketing).
model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  discountPct Int     // pourcentage de réduction, ex: 10 pour 10%
  expiresAt  DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

/// Slides du carrousel hero (page d'accueil).
/// Gérables depuis l'admin sans toucher au code.
model HeroSlide {
  id        String  @id @default(cuid())
  image     String
  eyebrowFr String  @default("")
  eyebrowEn String  @default("")
  titleFr   String
  titleEn   String
  textFr    String  @default("")
  textEn    String  @default("")
  order     Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
