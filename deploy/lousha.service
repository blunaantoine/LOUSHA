[Unit]
Description=Lousha Accessories — Next.js (port 3004)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/lousha
EnvironmentFile=/var/www/lousha/.env
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'exec bun run start'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
